---
import Base from '../../layouts/Base.astro';
import LiveProducts from '../../components/LiveProducts.astro';
import LiveCategories from '../../components/LiveCategories.astro';
import { company } from '../../data/catalog.js';

const canonicalUrl = 'https://eurocall-faragiannis.gr/proionta/metaxeirismena/';
const pageTitle = 'Μεταχειρισμένος Εξοπλισμός Μαζικής Εστίασης — Eurocall | Ιωάννινα';
const pageDescription = 'Ελεγμένος μεταχειρισμένος εξοπλισμός μαζικής εστίασης στα Ιωάννινα από τη Eurocall (από το 2000). Επαγγελματικά ψυγεία, φούρνοι, πλυντήρια, μηχανήματα. Τεχνικός έλεγχος, άμεση παράδοση, υποστήριξη.';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Αρχική', item: 'https://eurocall-faragiannis.gr/' },
    { '@type': 'ListItem', position: 2, name: 'Προϊόντα', item: 'https://eurocall-faragiannis.gr/#categories' },
    { '@type': 'ListItem', position: 3, name: 'Μεταχειρισμένα', item: canonicalUrl }
  ]
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Πώς ελέγχεται ο μεταχειρισμένος εξοπλισμός εστίασης πριν διατεθεί;',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Κάθε μεταχειρισμένο μηχάνημα στη Eurocall υποβάλλεται σε σχολαστικό τεχνικό έλεγχο: έλεγχος συμπιεστών, ηλεκτρικών αντιστάσεων, ψηφιακών θερμοστατών, αποσυναρμολόγηση, βαθύς καθαρισμός και δοκιμή πραγματικής λειτουργίας πριν παραδοθεί.'
      }
    },
    {
      '@type': 'Question',
      name: 'Μπορώ να συνδυάσω καινούριο και μεταχειρισμένο εξοπλισμό για την κουζίνα μου;',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Απολύτως. Σχεδιάζουμε ολοκληρωμένες γραμμές κουζίνας συνδυάζοντας καινούρια μηχανήματα, custom ανοξείδωτες κατασκευές inox δικής μας παραγωγής και ελεγμένα μεταχειρισμένα, ώστε να εξοικονομήσετε κεφάλαιο χωρίς έκπτωση στην ποιότητα.'
      }
    },
    {
      '@type': 'Question',
      name: 'Γίνεται αποστολή και υποστήριξη εκτός Ιωαννίνων;',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Ναι. Εξυπηρετούμε άμεσα όλη την Ήπειρο (Ιωάννινα, Άρτα, Πρέβεζα, Ηγουμενίτσα), τη Δυτική Ελλάδα, τα νησιά του Ιονίου (Λευκάδα, Κέρκυρα) καθώς και όλη την επικράτεια μέσω αξιόπιστων συνεργαζόμενων πρακτορείων μεταφορών.'
      }
    },
    {
      '@type': 'Question',
      name: 'Τι γίνεται αν χρειάζομαι μηχάνημα που δεν υπάρχει αυτή τη στιγμή στον κατάλογο;',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Το απόθεμα μεταχειρισμένου εξοπλισμού ανανεώνεται συνεχώς. Επικοινωνήστε μαζί μας στο 694 593 6149 — συχνά υπάρχουν διαθέσιμα μηχανήματα στο στάδιο του τεχνικού ελέγχου πριν αναρτηθούν online.'
      }
    }
  ]
};
---
<Base title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl} current="used">
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- PAGE HEAD -->
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow" style="color:#9fc2ff">Ελεγμένος Εξοπλισμός · Άμεση Διαθεσιμότητα</span>
      <h1>Μεταχειρισμένος Εξοπλισμός Μαζικής Εστίασης</h1>
      <p>Επιλεγμένα μεταχειρισμένα μηχανήματα για εστιατόρια, καφέ, ψητοπωλεία, πιτσαρίες, catering και ξενοδοχεία. Κάθε κομμάτι ελέγχεται εξονυχιστικά στις εγκαταστάσεις μας στα Ιωάννινα και παραδίδεται έτοιμο για εντατική επαγγελματική λειτουργία.</p>
    </div>
  </section>

  <!-- VALUE PROPOSITION STRIP -->
  <section class="herostrip">
    <div class="wrap">
      <div class="herostrip__in">
        <div class="herostat"><b>Πλήρης Έλεγχος</b><span>Δοκιμή σε συνθήκες πίεσης</span></div>
        <div class="herostat"><b>Έως 50% Οικονομία</b><span>Μείωση αρχικού κόστους</span></div>
        <div class="herostat"><b>Άμεση Παράδοση</b><span>Στις αποθήκες μας στην Πεδινή</span></div>
        <div class="herostat"><b>Τεχνική Κάλυψη</b><span>Ανταλλακτικά & υποστήριξη</span></div>
      </div>
    </div>
  </section>

  <!-- PRODUCTS GRID -->
  <section class="sec sec--steelbg">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Διαθέσιμα Τώρα</span>
        <h2>Επιλεγμένα Μεταχειρισμένα Μηχανήματα</h2>
        <p>Προσθέστε τα μηχανήματα που σας ενδιαφέρουν στη λίστα σας για να λάβετε προσφορά με ακριβείς τεχνικές προδιαγραφές και τιμές.</p>
      </div>
      <div class="prods prods--3" id="usedGrid"></div>
      <LiveProducts
        target="#usedGrid"
        mode="used"
        emptyMessage="Αυτή τη στιγμή τα διαθέσιμα μεταχειρισμένα ετοιμάζονται ή έχουν κρατηθεί. Επικοινωνήστε μαζί μας στο 694 593 6149 — το απόθεμα ανανεώνεται συνεχώς!"
      />

      <!-- CALLOUT BOX -->
      <div style="margin-top:40px;background:#fff;border:1.5px solid var(--line-l);padding:28px;border-radius:4px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:20px">
        <div style="max-width:680px">
          <h3 style="font-size:1.2rem;margin-bottom:6px">Δεν βρήκατε αυτό που ψάχνετε;</h3>
          <p style="font-size:0.95rem;color:var(--txt-body)">Η διαθεσιμότητα σε μεταχειρισμένους φούρνους, επαγγελματικά ψυγεία, πλυντήρια και μηχανήματα προετοιμασίας αλλάζει καθημερινά. Καλέστε μας απευθείας για να σας ενημερώσουμε για νέες παραλαβές.</p>
        </div>
        <div style="display:flex;gap:12px;align-items:center">
          <a href={`tel:${company.phoneHref}`} class="btn btn--flame">Τηλ: {company.phone}</a>
          <a href="/endiaferon" class="btn btn--ghost-d">Αίτημα προσφοράς</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTENT & E-E-A-T SECTION -->
  <section class="sec">
    <div class="wrap">
      <div class="custom" style="grid-template-columns:1.1fr 0.9fr;gap:48px;align-items:start">
        <div>
          <span class="eyebrow">Γιατί Eurocall</span>
          <h2 style="font-size:clamp(1.7rem, 2.5vw, 2.2rem);margin:14px 0 16px">25 χρόνια εγγύηση αξιοπιστίας στον μεταχειρισμένο εξοπλισμό</h2>
          <p style="margin-bottom:14px;color:var(--txt-body)">Η αγορά μεταχειρισμένου εξοπλισμού μαζικής εστίασης είναι ο πιο έξυπνος τρόπος να μειώσετε το κόστος επένδυσης όταν ανοίγετε ή ανανεώνετε ένα κατάστημα. Το κλειδί όμως είναι να γνωρίζετε ότι το μηχάνημα δεν θα σας εγκαταλείψει στην πρώτη γεμάτη βάρδια.</p>
          <p style="margin-bottom:18px;color:var(--txt-body)">Από το 2000, στη <strong>Eurocall</strong> δεν λειτουργούμε απλώς ως μεσάζοντες. Διαθέτουμε δικό μας τεχνικό τμήμα και εγκαταστάσεις παραγωγής στην Πεδινή Ιωαννίνων, ελέγχοντας κάθε εξάρτημα πριν φτάσει στον χώρο σας.</p>
          <ul style="list-style:none;display:flex;flex-direction:column;gap:10px;margin-bottom:24px">
            <li style="display:flex;gap:10px;color:var(--txt-dark);font-size:0.95rem"><b>✓</b> Πλήρης διαγνωστικός έλεγχος σε ηλεκτρολογικά, μοτέρ και αντιστάσεις.</li>
            <li style="display:flex;gap:10px;color:var(--txt-dark);font-size:0.95rem"><b>✓</b> Αντικατάσταση φθαρμένων εξαρτημάτων (φλάντζες, ρουλεμάν, θερμοστάτες).</li>
            <li style="display:flex;gap:10px;color:var(--txt-dark);font-size:0.95rem"><b>✓</b> Δυνατότητα συνδυασμού με καινούριες custom ανοξείδωτες κατασκευές στα μέτρα σας.</li>
            <li style="display:flex;gap:10px;color:var(--txt-dark);font-size:0.95rem"><b>✓</b> Συνεχής υποστήριξη με ανταλλακτικά και τεχνικό service.</li>
          </ul>
          <a href="/endiaferon" class="btn btn--flame">Συζητήστε τον εξοπλισμό σας μαζί μας</a>
        </div>
        <div style="background:var(--paper);border:1px solid var(--line-l);padding:32px;border-radius:6px">
          <h3 style="font-size:1.25rem;margin-bottom:16px;color:var(--txt-dark)">Βασικές Κατηγορίες Μεταχειρισμένων</h3>
          <div style="display:flex;flex-direction:column;gap:16px">
            <div style="border-bottom:1px solid var(--line-l);padding-bottom:12px">
              <strong style="color:var(--coal);display:block;font-size:1rem">Επαγγελματικά Ψυγεία & Καταψύκτες</strong>
              <span style="font-size:0.86rem;color:var(--txt-body)">Θάλαμοι συντήρησης/κατάψυξης, ψυχόμενοι πάγκοι εργασίας, saladettes, blast chillers.</span>
            </div>
            <div style="border-bottom:1px solid var(--line-l);padding-bottom:12px">
              <strong style="color:var(--coal);display:block;font-size:1rem">Επαγγελματικοί Φούρνοι & Ψήσιμο</strong>
              <span style="font-size:0.86rem;color:var(--txt-body)">Αερόθερμοι κυκλοθερμικοί, convection, φούρνοι πίτσας, πλατό ψησίματος, φριτέζες.</span>
            </div>
            <div style="border-bottom:1px solid var(--line-l);padding-bottom:12px">
              <strong style="color:var(--coal);display:block;font-size:1rem">Πλυντήρια Πιάτων & Ποτηριών</strong>
              <span style="font-size:0.86rem;color:var(--txt-body)">Πλυντήρια πάγκου 40×40 & 50×50, πλυντήρια καμπάνα (hood type), πλυντήρια σκευών.</span>
            </div>
            <div>
              <strong style="color:var(--coal);display:block;font-size:1rem">Μηχανήματα Bar & Επεξεργασίας</strong>
              <span style="font-size:0.86rem;color:var(--txt-body)">Παγομηχανές, ζαμπονομηχανές, κιμαδομηχανές, μπλέντερ & στίφτες επαγγελματικοί.</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ SECTION (GEO & AI Readiness) -->
  <section class="sec sec--steelbg">
    <div class="wrap" style="max-width:860px">
      <div class="sec-head" style="margin-inline:auto;text-align:center">
        <span class="eyebrow">Συχνές Ερωτήσεις</span>
        <h2>Όσα πρέπει να γνωρίζετε για τα μεταχειρισμένα</h2>
      </div>
      <div style="display:flex;flex-direction:column;gap:14px">
        {faqSchema.mainEntity.map((faq) => (
          <div style="background:#fff;border:1px solid var(--line-l);padding:24px;border-radius:4px">
            <h3 style="font-size:1.08rem;margin-bottom:8px;color:var(--txt-dark)">{faq.name}</h3>
            <p style="font-size:0.92rem;color:var(--txt-body);line-height:1.6">{faq.acceptedAnswer.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- OTHER CATEGORIES -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Ολοκληρωμένος Εξοπλισμός</span>
        <h2>Δείτε όλες τις κατηγορίες νέου εξοπλισμού</h2>
      </div>
      <div class="cats" id="otherCats"></div>
      <LiveCategories mode="other" target="#otherCats" excludeSlug="metaxeirismena" limit={4} />
    </div>
  </section>
</Base>
